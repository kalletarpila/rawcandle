#!/usr/bin/env bash
set -u

EXPECTED_REPO_ROOT="/home/kalle/projects/rawcandle"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPORTS_DIR="/home/kalle/projects/rawcandle/temp"
OUTPUT_HTML="/home/kalle/projects/rawcandle/temp/datacenter_dashboard.html"
REPORT_DATE=""
OUTPUT_EXPLICIT=0
WINDOWS_HTML="unavailable"
HTML_FILE_URL="unavailable"
IS_WSL=0

print_help() {
  cat <<'EOF'
Usage:
  ./start_dc_dashboard_ui
  ./start_dc_dashboard_ui --reports-dir /path/to/reports
  ./start_dc_dashboard_ui --output /path/to/dashboard.html
  ./start_dc_dashboard_ui --report-date YYYY-MM-DD
  ./start_dc_dashboard_ui --help
EOF
}

is_wsl_environment() {
  if [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    return 0
  fi
  if [[ -r /proc/version ]] && grep -qiE 'microsoft|wsl' /proc/version; then
    return 0
  fi
  return 1
}

build_windows_path() {
  if command -v wslpath >/dev/null 2>&1; then
    wslpath -w "$OUTPUT_HTML"
    return 0
  fi
  return 1
}

build_file_url() {
  if [[ "$WINDOWS_HTML" != "unavailable" ]]; then
    local url_path
    url_path="$(printf '%s' "$WINDOWS_HTML" | sed 's#\\#/#g')"
    printf 'file:%s\n' "$url_path"
    return 0
  fi
  printf 'file://%s\n' "$OUTPUT_HTML"
}

print_manual_instructions() {
  echo "Open manually in Firefox:"
  echo "1. Copy this path:"
  if [[ "$WINDOWS_HTML" != "unavailable" ]]; then
    echo "$WINDOWS_HTML"
  else
    echo "$OUTPUT_HTML"
  fi
  echo "2. Paste it into Firefox address bar."
  echo "Linux path:"
  echo "$OUTPUT_HTML"
  echo "Windows path:"
  echo "$WINDOWS_HTML"
}

try_open() {
  local opener_name="$1"
  shift
  if "$@"; then
    echo "SUMMARY open_status=OK"
    echo "SUMMARY opener=$opener_name"
    return 0
  fi
  return 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --reports-dir)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --reports-dir" >&2
        exit 2
      fi
      REPORTS_DIR="$2"
      shift 2
      ;;
    --output)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --output" >&2
        exit 2
      fi
      OUTPUT_HTML="$2"
      OUTPUT_EXPLICIT=1
      shift 2
      ;;
    --report-date)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --report-date" >&2
        exit 2
      fi
      REPORT_DATE="$2"
      shift 2
      ;;
    --help)
      print_help
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      print_help >&2
      exit 2
      ;;
  esac
done

if [[ "$SCRIPT_DIR" != "$EXPECTED_REPO_ROOT" ]]; then
  echo "WARNING resolved_repo_root=$SCRIPT_DIR expected_repo_root=$EXPECTED_REPO_ROOT"
fi

cd "$SCRIPT_DIR" || exit 1

if is_wsl_environment; then
  IS_WSL=1
fi

if [[ -n "$REPORT_DATE" && "$OUTPUT_EXPLICIT" -eq 0 ]]; then
  OUTPUT_HTML="$REPORTS_DIR/datacenter_dashboard_${REPORT_DATE}.html"
fi

echo "SUMMARY reports_dir=$REPORTS_DIR"
echo "SUMMARY html_output=$OUTPUT_HTML"

if [[ -n "$REPORT_DATE" ]]; then
  if ! PYTHONPATH=. python3 dev_tools/run_datacenter_dashboard_html.py \
    --reports-dir "$REPORTS_DIR" \
    --output "$OUTPUT_HTML" \
    --report-date "$REPORT_DATE"; then
    echo "SUMMARY generate_status=FAILED"
    echo "SUMMARY open_status=SKIPPED"
    echo "SUMMARY opener=none"
    exit 1
  fi
else
  if ! PYTHONPATH=. python3 dev_tools/run_datacenter_dashboard_html.py \
    --reports-dir "$REPORTS_DIR" \
    --output "$OUTPUT_HTML"; then
    echo "SUMMARY generate_status=FAILED"
    echo "SUMMARY open_status=SKIPPED"
    echo "SUMMARY opener=none"
    exit 1
  fi
fi

echo "SUMMARY generate_status=OK"

if windows_path="$(build_windows_path)"; then
  WINDOWS_HTML="$windows_path"
fi
echo "SUMMARY html_output_windows=$WINDOWS_HTML"

HTML_FILE_URL="$(build_file_url)"
echo "SUMMARY html_file_url=$HTML_FILE_URL"

if [[ "$IS_WSL" -eq 1 ]]; then
  if [[ "$WINDOWS_HTML" != "unavailable" ]] && command -v cmd.exe >/dev/null 2>&1; then
    if try_open "cmd.exe" cmd.exe /C start "" "$WINDOWS_HTML"; then
      exit 0
    fi
  fi
  if [[ "$WINDOWS_HTML" != "unavailable" ]] && command -v powershell.exe >/dev/null 2>&1; then
    if try_open "powershell.exe" powershell.exe -NoProfile -Command "Start-Process '$WINDOWS_HTML'"; then
      exit 0
    fi
  fi
  if [[ "$WINDOWS_HTML" != "unavailable" ]] && command -v firefox.exe >/dev/null 2>&1; then
    if try_open "firefox.exe" firefox.exe "$WINDOWS_HTML"; then
      exit 0
    fi
  fi
  if [[ "$WINDOWS_HTML" != "unavailable" ]] && command -v explorer.exe >/dev/null 2>&1; then
    if try_open "explorer.exe" explorer.exe "$WINDOWS_HTML"; then
      exit 0
    fi
  fi
  if command -v firefox >/dev/null 2>&1; then
    if try_open "firefox" firefox "$OUTPUT_HTML"; then
      exit 0
    fi
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    if try_open "xdg-open" xdg-open "$OUTPUT_HTML"; then
      exit 0
    fi
  fi
else
  if command -v firefox >/dev/null 2>&1; then
    if try_open "firefox" firefox "$OUTPUT_HTML"; then
      exit 0
    fi
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    if try_open "xdg-open" xdg-open "$OUTPUT_HTML"; then
      exit 0
    fi
  fi
fi

echo "SUMMARY open_status=FAILED"
echo "SUMMARY opener=none"
echo "SUMMARY html_output=$OUTPUT_HTML"
print_manual_instructions
exit 0
