"""Random data generator for analysis_findings.

This module provides a simple, deterministic-capable generator for creating
fake analysis_findings rows for testing and demo purposes.
"""

from typing import Optional
import random
from datetime import date, timedelta

from .database_manager import DatabaseManager


DEFAULT_PATTERNS = [
    "Hammer",
    "Bullish Engulfing",
    "Piercing Pattern",
    "Three White Soldiers",
    "Morning Star",
    "Dragonfly Doji",
]


def generate_random_findings(
    num_tickers: int = 100,
    events_per_ticker: int = 20,
    db_path: Optional[str] = None,
    start_date: Optional[date] = None,
    seed: Optional[int] = None,
) -> int:
    """Generate random findings and insert them into the analysis DB.

    Args:
        num_tickers: how many distinct tickers to create (1..1000)
        events_per_ticker: events per ticker (1..200)
        db_path: optional path to the sqlite DB (defaults to analysis/analysis.db)
        start_date: optional base date for generated events (default: today)
        seed: optional RNG seed for reproducible output

    Returns:
        int: number of rows inserted
    """
    # Validate and coerce inputs
    try:
        num_tickers = int(num_tickers)
    except Exception:
        num_tickers = 100

    try:
        events_per_ticker = int(events_per_ticker)
    except Exception:
        events_per_ticker = 20

    # enforce sensible bounds
    num_tickers = max(1, min(1000, num_tickers))
    events_per_ticker = max(1, min(200, events_per_ticker))

    if seed is not None:
        random.seed(seed)

    db = DatabaseManager(db_path=db_path or "analysis/analysis.db")

    if start_date is None:
        start_date = date.today()

    inserted = 0

    for i in range(1, num_tickers + 1):
        ticker = f"T{i:04d}"
        for j in range(events_per_ticker):
            # spread dates backward up to 365 days
            delta_days = random.randint(0, 365)
            evt_date = (start_date - timedelta(days=delta_days)).isoformat()

            pattern = random.choice(DEFAULT_PATTERNS)
            signal_strength = round(random.random(), 3)
            price = round(random.uniform(1.0, 1000.0), 2)
            volume = random.randint(100, 100000)
            description = f"Auto-generated event {j+1} for {ticker}"

            ok = db.insert_finding(
                ticker=ticker,
                date=evt_date,
                pattern=pattern,
                signal_strength=signal_strength,
                price=price,
                volume=volume,
                description=description,
            )
            if ok:
                inserted += 1

    try:
        db.close()
    except Exception:
        pass

    return inserted
